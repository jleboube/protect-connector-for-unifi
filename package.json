{
  "name": "protect-connector-for-unifi",
  "private": true,
  "version": "0.1.0",
  "description": "Community MCP connectors for UniFi Protect (and later UniFi Network). Not affiliated with Ubiquiti.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm run build && vitest run",
    "mock": "node packages/mock-protect/dist/cli.js",
    "deploy:worker": "pnpm --filter @unifi-mcp/protect run deploy"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
